<resources>
    <style name="Theme.YourBrowser" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_sniffer</item>
        <item name="colorSecondary">@color/accent_secure</item>
        <item name="colorError">@color/accent_panic</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="android:statusBarColor">@color/surface_card</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowBackground">@color/surface_ground</item>
        <item name="bottomSheetDialogTheme">@style/Theme.YourBrowser.BottomSheetDialog</item>
    </style>

    <style name="Theme.YourBrowser.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Theme.YourBrowser.BottomSheetModal</item>
    </style>

    <style name="Theme.YourBrowser.BottomSheetModal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_card</item>
        <item name="shapeAppearance">@style/ShapeAppearance.YourBrowser.LargeComponent</item>
    </style>

    <style name="ShapeAppearance.YourBrowser.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
