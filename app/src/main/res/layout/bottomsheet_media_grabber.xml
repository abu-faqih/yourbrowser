<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/detected_videos"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/pbDownloadProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvDownloadStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnExportGallery"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/vault_green"
        android:text="📥 Ekspor ke Galeri Publik"
        android:textColor="@color/primary_dark"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Pesan panduan saat belum ada video diputar -->
    <TextView
        android:id="@+id/tvEmptyMediaGuide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/badge_vault"
        android:lineSpacingExtra="4dp"
        android:padding="16dp"
        android:text="🔍 Belum ada video yang diputar pada halaman ini.\n\n💡 Tips Seperti UC Browser:\nCukup buka halaman web mana saja (YouTube, streaming film, medsos, dll) dan tekan tombol Play pada video. YourBrowser akan otomatis mencegat tautan streaming video tersebut dan memunculkan tombol unduhan di sini."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMediaStreams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="300dp" />

</LinearLayout>
