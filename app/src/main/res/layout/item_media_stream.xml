<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_container"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Badge, Title, Size -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Resolution Badge -->
        <TextView
            android:id="@+id/tvResolutionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_accent"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="1080p FHD"
            android:textColor="@color/surface_ground"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStreamTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="HLS Master Stream"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEstimatedSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:text="~145 MB"
            android:textColor="@color/accent_sniffer"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle: Codec & Format Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="Video format"
            android:src="@drawable/ic_play"
            app:tint="@color/accent_sniffer" />

        <TextView
            android:id="@+id/tvStreamFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Video AVC/H.264 • Segmen HLS (.m3u8)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action Buttons: Putar di Player & Unduh Langsung -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPlayStream"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_container_high"
            android:fontFamily="sans-serif-medium"
            android:text="Putar Video"
            android:textColor="@color/accent_sniffer"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="@color/accent_sniffer" />

        <Button
            android:id="@+id/btnDownloadStream"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/accent_sniffer"
            android:fontFamily="sans-serif-medium"
            android:text="@string/download_now_caps"
            android:textColor="@color/surface_ground"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_bolt"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="@color/surface_ground" />
    </LinearLayout>

</LinearLayout>
