<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_ground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Vault Status & Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Vault ID Chip -->
        <TextView
            android:id="@+id/tvTabVaultId"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/badge_vault"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:text="🔒 VAULT: 9a4f8e12"
            android:textColor="@color/accent_secure"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- New Tab Button -->
        <Button
            android:id="@+id/btnNewTab"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/accent_sniffer"
            android:fontFamily="sans-serif-medium"
            android:text="+ Tab Baru"
            android:textColor="@color/surface_ground"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <ImageButton
            android:id="@+id/btnCloseTabManager"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_shield"
            android:contentDescription="Tutup"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Subheader Security Micro-Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_container_low"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvTabManagerCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tab Aktif: 1"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_container_lowest"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Isolasi Sesi"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_card_container_lowest"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Anti-Leak"
            android:textColor="@color/accent_secure"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Grid 2-Kolom Tabs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTabsGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

</LinearLayout>
