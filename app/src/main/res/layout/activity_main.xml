<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas">

    <!-- Top App Bar / Omnibox Strip -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/omnibox_strip"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bg_canvas"
        android:paddingHorizontal="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Shields Indicator Pill -->
        <FrameLayout
            android:id="@+id/btn_shields"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_primary"
            android:paddingHorizontal="10dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/txt_shields_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Omnibox Capsule -->
        <LinearLayout
            android:id="@+id/omnibox_capsule"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_omnibox"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_tabs"
            app:layout_constraintStart_toEndOf="@+id/btn_shields"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/img_security_lock"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/accent_cyan" />

            <EditText
                android:id="@+id/edt_omnibox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btn_bookmark"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_star" />
        </LinearLayout>

        <!-- Tabs Switcher Button -->
        <FrameLayout
            android:id="@+id/btn_tabs"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_tab_badge"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_more"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txt_tab_count"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Menu Button -->
        <ImageView
            android:id="@+id/btn_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Page Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/page_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:max="100"
        android:progressDrawable="@drawable/bg_pill_primary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/omnibox_strip" />

    <!-- Web Container -->
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
        app:layout_constraintTop_toBottomOf="@+id/page_progress_bar" />

    <!-- Tab Password Protection Overlay -->
    <LinearLayout
        android:id="@+id/layout_tab_lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bg_canvas"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
        app:layout_constraintTop_toBottomOf="@+id/page_progress_bar">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/accent_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tab Session Protected"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Enter passcode / PIN to unlock this tab"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edt_unlock_passcode"
            android:layout_width="220dp"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_omnibox"
            android:gravity="center"
            android:hint="Passcode / PIN"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted" />

        <Button
            android:id="@+id/btn_submit_unlock"
            android:layout_width="220dp"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_primary"
            android:text="Unlock Tab"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/surface_1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_back" />

        <ImageView
            android:id="@+id/btn_forward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_forward" />

        <ImageView
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_shield" />

        <ImageView
            android:id="@+id/btn_reload"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/btn_new_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_plus" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
